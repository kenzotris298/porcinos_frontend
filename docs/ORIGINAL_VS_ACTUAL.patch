+
+vi.mock('../api/client', () => ({
+  apiRequest: vi.fn()
+}));
+
+const evaluationId = '89011034-5e4e-43e7-ae46-314ec5fe2698';
+const evaluation = {
+  id: evaluationId,
+  farmId: 'farm-1',
+  fecha: '2026-11-04',

+      const [evaluationResponse, farmResponse] = await Promise.all([
+        apiRequest<{ items: ApiEvaluation[] }>('/evaluations'),
+        apiRequest<{ items: ApiFarm[] }>('/farms')
+      ]);
+      setEvaluations(evaluationResponse.items);
+      setFarms(farmResponse.items);
+      setEvaluationId((current) =>
+        evaluationResponse.items.some((item) => item.id === current)
+          ? current
+          : evaluationResponse.items[0]?.id ?? ''
+      );
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : 'No se pudieron cargar las evaluaciones.');
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => { void loadEvaluations(); }, [loadEvaluations]);
+
+  const loadDetails = useCallback(async () => {
+    if (!evaluationId) {
+      setIndicators([]);
+      setEvidence([]);
+      return;
+    }
+    setError('');
+    try {
+      const [indicatorResponse, evidenceResponse] = await Promise.all([
+        apiRequest<{ items: ApiIndicator[] }>(`/indicators?evaluationId=${encodeURIComponent(evaluationId)}`),
+        apiRequest<{ items: ApiEvidence[] }>(`/evidence?evaluationId=${encodeURIComponent(evaluationId)}`)
+      ]);
+      setIndicators(indicatorResponse.items);
+      setEvidence(evidenceResponse.items);
+      setIndicatorId((current) =>
+        indicatorResponse.items.some((item) => item.id === current)
+          ? current
+          : indicatorResponse.items[0]?.id ?? ''
+      );
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : 'No se pudieron cargar las evidencias.');
